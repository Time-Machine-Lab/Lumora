{
  "name": "lumora",
  "version": "0.1.0",
  "private": true,
  "description": "Lumora — 可嵌入的 3D 资产创作 Web 应用与插件平台",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @lumora/core && npm run build -w @lumora/plugin-sdk && npm run build -w @lumora/studio && npm run build -w @lumora/mock-plugin && npm run build -w @lumora/openai-compatible-plugin && npm run build -w @lumora/embedded-host",
    "dev": "npm run dev -w examples/embedded-host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:preview": "node scripts/check-preview-prerequisites.mjs && playwright test --config playwright.preview.config.ts",
    "e2e:install": "playwright install chromium firefox webkit",
    "e2e:recording": "playwright test e2e/recording-shortcut.spec.ts",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "smoke:pack:boundary": "node scripts/smoke-pack.mjs --self-test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
